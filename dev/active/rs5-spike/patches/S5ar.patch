index 0000000..03f7544
--- /dev/null
+++ b/app/src/data/saveLedger.ts
@@ -0,0 +1,97 @@
+/**
+ * RS5 스파이크 — CONTRACT-5 8.2 1행(진입 최소 장부)만. 제품 구현 아님 · 측정 뒤 원복.
+ * 상태 Map · view · acquire · release · publish · mark · I8 beforeunload 토글. save·confirm·retryStart 본문 = 없음(조작 뒤 · 미측정).
+ */
+import type { DocHead } from "./projectRepository";
+import type { RenderImages } from "../features/studio/images/store/types";
+
+export interface DraftInput {
+  readonly doc: DocHead;
+  readonly hash: string;
+  readonly images: RenderImages;
+}
+interface Draft extends DraftInput {
+  readonly seq: number;
+  readonly baseEpoch: number;
+}
+interface Ledger {
+  latest?: Draft;
+  nextSeq: number;
+  epoch: number;
+  dirtyMark: number;
+  publishedMark: number;
+  conflicted?: DocHead;
+  memHead?: DocHead;
+  memSeq: number;
+  confirmedSeq: number;
+  lease?: object;
+  inflight?: Promise<unknown>;
+  start?: unknown;
+}
+export interface LedgerView {
+  readonly latest?: Draft;
+  readonly conflicted?: DocHead;
+  readonly memHead?: DocHead;
+  readonly unconfirmed: boolean;
+}
+export interface SaveLedgerApi {
+  acquire(projectId: string): { readonly token: object; readonly seed: LedgerView };
+  release(token: object, last?: DraftInput): void;
+  mark(token: object): void;
+  publish(token: object, input: DraftInput): number | "superseded";
+  view(projectId: string): LedgerView;
+}
+
+export function createSaveLedger(local: boolean): SaveLedgerApi {
+  const ledgers = new Map<string, Ledger>();
+  /** 감량(S5a-r): 토큰 → 장부 직접(프로젝트 id 재조회 0) */
+  const owners = new WeakMap<object, Ledger>();
+  const of = (projectId: string) =>
+    ledgers.get(projectId) ?? ledgers.set(projectId, { nextSeq: 1, epoch: 0, dirtyMark: 0, publishedMark: 0, memSeq: 0, confirmedSeq: 0 }).get(projectId)!;
+  /** I9 — 대체된 임대의 호출은 쓰기 0 */
+  const leased = (token: object) => {
+    const ledger = owners.get(token);
+    return ledger?.lease === token ? ledger : undefined;
+  };
+  /** I8 술어 */
+  const unconfirmed = (l: Ledger) => l.dirtyMark > l.publishedMark || (!!l.latest && l.latest.seq > l.confirmedSeq) || !!l.inflight || !!l.start || !!l.conflicted;
+  /** 감량(S5a-r): returnValue 대입 생략 — preventDefault만(현행 브라우저 경고 조건) */
+  const block = (event: BeforeUnloadEvent) => event.preventDefault();
+  let guarded = false;
+  const guard = () => {
+    const next = local && [...ledgers.values()].some(unconfirmed);
+    if (next !== guarded) window[(guarded = next) ? "addEventListener" : "removeEventListener"]("beforeunload", block);
+  };
+  const view = (projectId: string): LedgerView => {
+    const ledger = of(projectId);
+    return { latest: ledger.latest, conflicted: ledger.conflicted, memHead: ledger.memHead, unconfirmed: unconfirmed(ledger) };
+  };
+  const publish = (token: object, input: DraftInput) => {
+    const ledger = leased(token);
+    if (!ledger) return "superseded" as const;
+    ledger.latest = Object.freeze({ ...input, seq: ledger.nextSeq++, baseEpoch: ledger.epoch });
+    ledger.publishedMark = ledger.dirtyMark;
+    guard();
+    return ledger.latest.seq;
+  };
+  return {
+    acquire: (projectId) => {
+      const token = {};
+      owners.set(token, (of(projectId).lease = token, of(projectId)));
+      return { token, seed: view(projectId) };
+    },
+    release: (token, last) => {
+      const ledger = leased(token);
+      if (!ledger) return;
+      if (last) publish(token, last);
+      ledger.lease = undefined;
+      guard();
+    },
+    mark: (token) => {
+      const ledger = leased(token);
+      if (ledger) ledger.dirtyMark += 1, guard();
+    },
+    publish,
+    view,
+  };
+}
