+/** 편집 시작 결과 — 이동(state) 또는 알림(alert 없음 = 프로필 화면의 일반 실패 문형 · retry = "다시 시도" 버튼) */
+export type EditStart = { readonly state: StudioEntryState } | { readonly alert?: string; readonly retry: boolean };
+
+/**
+ * "편집 시작"(DS-2A-05 12.3 · 8.3.1): 성공·DOC_EXISTS = 이동(바뀐 쌍 · 편집 알림) · UNKNOWN_VARIANT = 알림(다시 시도 없음) ·
+ * 그 밖(요청·로더 실패 포함) = 일반 실패 + 다시 시도(같은 인자 → 멱등). 던지지 않는다.
+ */
+export async function startEdit(start: () => Promise<StartDocResult<unknown>>): Promise<EditStart> {
+  try {
+    const started = await start();
+    return { state: { changes: started.changes, editNotice: started.changeNotice } };
+  } catch (error: unknown) {
+    if (!(error instanceof ProjectRepositoryError)) return { retry: true };
+    if (error.code === "DOC_EXISTS") return { state: { editNotice: error.alert } };
+    if (error.code === "UNKNOWN_VARIANT") return { ...(error.alert && { alert: error.alert }), retry: false };
+    return { retry: true };
+  }
+}
