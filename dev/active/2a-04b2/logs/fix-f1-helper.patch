+/**
+ * FIX-2A04b2 F1 배선 — 조작 뒤 로더 전부가 retryableImport로 싸여 있고, 넘긴 청크 이름이 정적 import() 대상 파일 이름과 같다
+ * (빌드 청크는 `<파일 이름>-<해시>.js` — 이름이 다르면 재시도 URL을 찾지 못해 고친 효과가 사라진다).
+ * 자동 로더(boardEngine·profileEngine·memoryStudio·픽스처)는 싸지 않는다 — 실패하면 경계로 간다(범위 밖).
+ */
+import { describe, expect, it, vi } from "vitest";
+
+const wrapped = vi.hoisted(() => new Map<string, () => Promise<Record<string, unknown>>>());
+vi.mock("./chunkRetry", () => ({
+  retryableImport: (chunk: string, load: () => Promise<Record<string, unknown>>) => {
+    wrapped.set(chunk, load);
+    return load;
+  },
+}));
+
+describe("조작 뒤 로더 배선", () => {
+  it("보드 확정 본문 · 프로필 쓰기 본문 · P-S25 패널 · 재확정 이어받기 규칙 — 청크 이름 = 모듈 파일 이름", async () => {
+    await import("./writeBodyLoader");
+    await import("../features/compare/carryOverLoader");
+    await import("./memoryBoardConfirm");
+    expect([...wrapped.keys()].sort()).toEqual(["carryOverPanel", "memoryBoardConfirm", "memoryProfileAdjust", "profileAdjustments"]);
+    const exports = { memoryBoardConfirm: "createBoardConfirmer", memoryProfileAdjust: "revertIn", carryOverPanel: "CarryOverNotice", profileAdjustments: "carryOverAdjustments" };
+    for (const [chunk, name] of Object.entries(exports)) {
+      expect(await wrapped.get(chunk)!()).toHaveProperty(name);
+    }
+  });
+});
