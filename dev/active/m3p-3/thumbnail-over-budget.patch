+/**
+ * 카드 썸네일 img 속성 (M3P-3 · SPEC m3p 4.1·5·7절) — 키 맵과 함께 `import()`로 받는 지연 청크(첫 화면 예산 — 카드에는 상태 토글만 남긴다).
+ * JSX 대신 속성만 돌려준다(이 청크가 다른 청크에 기대지 않아 프리로드 목록이 카드 청크에 붙지 않는다). 키가 없으면 undefined(와이어 유지).
+ */
+import type { ImgHTMLAttributes } from "react";
+import type { DesignReference } from "../../domain/reference";
+import { THUMBNAIL_KEYS, thumbnailPath } from "./thumbnailKeys";
+
+export type ThumbnailImage = (reference: DesignReference) => ImgHTMLAttributes<HTMLImageElement> | undefined;
+
+export const thumbnailImageOf =
+  (keys: Readonly<Record<string, string>>): ThumbnailImage =>
+  (r) => {
+    const key = keys[r.id];
+    return key === undefined
+      ? undefined
+      : {
+          src: thumbnailPath(key),
+          alt: `${r.title} 첫 화면 실제 렌더 미리보기`,
+          loading: "lazy",
+          decoding: "async",
+          className: "absolute inset-0 size-full rounded-lg object-cover object-top",
+        };
+  };
+
+export const THUMBNAIL_IMAGE = thumbnailImageOf(THUMBNAIL_KEYS);
