+/**
+ * store(무압축) ZIP 작성기 (M4-a-1 스파이크 · 의존성 0) — 로컬 헤더 · 중앙 디렉터리 · EOCD · CRC-32 · UTF-8 이름(플래그 bit 11).
+ * 데이터 기술자(bit 3) 0 · ZIP64 0 — 크기·오프셋이 4GiB-1 이상이거나 항목이 65535개를 넘으면 실패(이미지 보관 한도 30MB라 닿지 않는다).
+ * 결과는 조각 배열(Uint8Array[]) — 본문을 복사하지 않고 Blob 조각으로 넘긴다.
+ */
+export interface ZipEntry {
+  /** `/` 구분 상대 경로(앞 `/`·`..`·`\` 금지) */
+  readonly name: string;
+  readonly data: Uint8Array;
+}
+
+const CRC_TABLE = /* @__PURE__ */ (() => {
+  const table = new Uint32Array(256);
+  for (let n = 0; n < 256; n++) {
+    let c = n;
+    for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
+    table[n] = c >>> 0;
+  }
+  return table;
+})();
+
+export function crc32(data: Uint8Array): number {
+  let c = 0xffffffff;
+  for (let i = 0; i < data.length; i++) c = CRC_TABLE[(c ^ data[i]!) & 0xff]! ^ (c >>> 8);
+  return (c ^ 0xffffffff) >>> 0;
+}
+
+const MAX32 = 0xffffffff;
+const BAD_NAME = /(^\/)|(^|\/)\.\.(\/|$)|\\|^$/;
+
+export function zipParts(entries: readonly ZipEntry[], date = new Date()): Uint8Array[] {
+  if (entries.length > 0xffff) throw new Error("ZIP 항목이 너무 많습니다");
+  const time = (date.getHours() << 11) | (date.getMinutes() << 5) | (date.getSeconds() >> 1);
+  const day = ((Math.max(1980, date.getFullYear()) - 1980) << 9) | ((date.getMonth() + 1) << 5) | date.getDate();
+  const encoder = new TextEncoder();
+  const parts: Uint8Array[] = [];
+  const central: Uint8Array[] = [];
+  let offset = 0;
+  for (const { name, data } of entries) {
+    if (BAD_NAME.test(name)) throw new Error(`ZIP 경로가 올바르지 않습니다: ${name}`);
+    const bytes = encoder.encode(name);
+    const crc = crc32(data);
+    if (offset + 30 + bytes.length + data.length >= MAX32) throw new Error("ZIP64가 필요한 크기입니다");
+    // 공통 필드(버전 2.0 · UTF-8 · store · 시각 · CRC · 크기 2번 · 이름 길이 · extra 0)
+    const common = (view: DataView, at: number) => {
+      view.setUint16(at, 20, true);
+      view.setUint16(at + 2, 0x0800, true);
+      view.setUint16(at + 4, 0, true);
+      view.setUint16(at + 6, time, true);
+      view.setUint16(at + 8, day, true);
+      view.setUint32(at + 10, crc, true);
+      view.setUint32(at + 14, data.length, true);
+      view.setUint32(at + 18, data.length, true);
+      view.setUint16(at + 22, bytes.length, true);
+    };
+    const local = new Uint8Array(30 + bytes.length);
+    const lv = new DataView(local.buffer);
+    lv.setUint32(0, 0x04034b50, true);
+    common(lv, 4);
+    local.set(bytes, 30);
+    const head = new Uint8Array(46 + bytes.length);
+    const hv = new DataView(head.buffer);
+    hv.setUint32(0, 0x02014b50, true);
+    hv.setUint16(4, 20, true);
+    common(hv, 6);
+    hv.setUint32(42, offset, true);
+    head.set(bytes, 46);
+    parts.push(local, data);
+    central.push(head);
+    offset += local.length + data.length;
+  }
+  const size = central.reduce((sum, head) => sum + head.length, 0);
+  if (offset + size >= MAX32) throw new Error("ZIP64가 필요한 크기입니다");
+  const end = new Uint8Array(22);
+  const ev = new DataView(end.buffer);
+  ev.setUint32(0, 0x06054b50, true);
+  ev.setUint16(8, entries.length, true);
+  ev.setUint16(10, entries.length, true);
+  ev.setUint32(12, size, true);
+  ev.setUint32(16, offset, true);
+  return [...parts, ...central, end];
+}
+
+export const storeZip = (entries: readonly ZipEntry[], date?: Date) => new Blob(zipParts(entries, date) as BlobPart[], { type: "application/zip" });
