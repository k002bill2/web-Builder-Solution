guardrails.json	hook	Notification	*	payload="$(cat)" msg="$(printf '%s' "$payload" | { if command -v jq >/dev/null 2>&1; then jq -r '.message // empty'; else python3 -c 'import json,sys;sys.stdout.write(json.load(sys.stdin).get("message") or "")'; fi; } 2>/dev/null | head -1)" [ -n "$msg" ] || msg="Claude Code" if command -v osascript >/dev/null 2>&1; then   osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "Claude Code"' -e 'end run' -- "$msg" >/dev/null 2>&1 elif command -v notify-send >/dev/null 2>&1; then   notify-send -a "Claude Code" "$msg" >/dev/null 2>&1 else   printf '[Notification] %s\n' "$msg" >&2 fi exit 0
guardrails.json	hook	PreToolUse	Bash	python3 -c "$(cat <<'GUARD_BASH' import json, posixpath, re, sys  LIMIT = 10 * 1024 * 1024 data = sys.stdin.read(LIMIT + 1) if len(data) > LIMIT:     sys.stderr.write("guardrails: stdin exceeds 10MB limit\n")     sys.exit(2) try:     payload = json.loads(data) except Exception as exc:                      # malformed -> fail closed     sys.stderr.write("guardrails: malformed hook payload: %s\n" % exc)     sys.exit(2)  cmd = payload.get("tool_input", {}).get("command", "") or "" if not cmd:     sys.exit(0)  if re.search(r"(?i)\bDROP\s+TABLE\b", cmd) \    or re.search(r"\bmkfs\b", cmd) \    or re.search(r"\bdd\b[^;&|]*\bif=/dev/(zero|random|urandom)\b", cmd):     sys.stderr.write("guardrails: destructive command blocked\n")     sys.exit(2)  # 따옴표는 경계 판정만 방해한다 — `rm -rf "/etc"` 가 통과하던 우회 경로였다. # 경로 검사 전용 사본에서 따옴표를 **공백으로** 바꾼다(제거하면 토큰이 붙어 # 경계가 무너진다). 원본 cmd 는 위의 파괴적 명령 검사에 그대로 쓰인다. probe = cmd.replace('"', " ").replace("'", " ") # 경로 표기를 정규화한다. `/tmp/../etc` 와 `//etc` 는 결국 보호 경로인데 # 문자열 그대로 보면 경계 검사가 다른 경로로 보고 통과시킨다. # posixpath.normpath 는 선행 `//` 를 보존하므로 슬래시 축약을 먼저 한다. # 주의: 정규식에 `{n,m}` 브레이스 수량자를 쓰지 말 것 — 이 스크립트는 셸 # 히어독을 거쳐 전달되고, 셸 브레이스 확장이 `/{2,}` 를 `/2` 로 바꾼다(실측). def _norm_tok(t):     if "/" not in t:         return t     return posixpath.normpath(re.sub(r"//+", "/", t)) # 셸은 토큰 내부 따옴표를 **제거하고 이어붙인다**(`/e"tc"` -> `/etc`). # 공백 치환본만 보면 그 형태가 빠지고, 제거본만 보면 `" "` 안의 진짜 공백이 # 사라진다. 두 해석을 모두 만들어 하나라도 걸리면 차단한다(보수적). def _mk(p):     return " ".join(_norm_tok(t) for t in p.split()) # 보호 경로에 붙은 셸 확장(`/etc${UNSET-}`)은 셸이 없애고 `/etc` 를 실행하는데 # 정규식은 `$` 를 경계가 아니라고 본다. 확장을 지운 해석도 후보에 넣는다. # ($HOME 자체를 보는 검사는 다른 후보가 담당하므로 손실이 없다.) _dq = cmd.replace('"', "").replace("'", "") _noexp = re.sub(r"\$\{[^}]*\}|\$[A-Za-z_][A-Za-z0-9_]*", "", _dq) PROBES = [_mk(probe), _mk(_dq), _mk(_noexp)] # 경계 문자에 `;&|` 를 포함한다 — 복합 명령에서 보호 경로 바로 뒤에 세미콜론이 # 오면 공백이 없어 경계로 인정되지 않아 그대로 통과했다(실측 exit 0). # rm 대상 경로는 "경계까지" 본다. /etc 는 막고 /etcd-backup.tar 는 막지 않는다. EXACT = ["/", "~", "$HOME", "${HOME}"]              # 루트/홈 통째 삭제만 차단 SUBTREE = ["/etc", "/sys", "/dev", "/boot", "/proc", "/root/.ssh"] # 꼬리 `/*\*?` = 슬래시 반복 + 선택적 글로브 1개. 정규식의 `/*` 는 글로브가 아니라 # "슬래시 0회 이상"이라, 이것이 없으면 통째 삭제의 정본인 `rm -rf /*` 와 # `rm -rf ~/*` 가 통과한다. 뒤의 lookahead 가 경계를 지키므로 `/tmp/x` 는 그대로 통과. for target in EXACT:     if any(re.search(r"\brm\b[^;&|]*\s" + re.escape(target) + r"/*\*?(?=$|[\s;&|])", _p) for _p in PROBES):         sys.stderr.write("guardrails: refusing rm on %s\n" % target)         sys.exit(2) for target in SUBTREE:     if any(re.search(r"\brm\b[^;&|]*\s" + re.escape(target) + r"(?=$|[\s/;&|])", _p) for _p in PROBES):         sys.stderr.write("guardrails: refusing rm under %s\n" % target)         sys.exit(2) sys.exit(0) GUARD_BASH )"
guardrails.json	hook	PreToolUse	Edit|Write	python3 -c "$(cat <<'GUARD_EDIT' import json, posixpath, re, sys  LIMIT = 10 * 1024 * 1024 data = sys.stdin.read(LIMIT + 1) if len(data) > LIMIT:     sys.stderr.write("guardrails: stdin exceeds 10MB limit\n")     sys.exit(2) try:     payload = json.loads(data) except Exception as exc:                      # malformed -> fail closed     sys.stderr.write("guardrails: malformed hook payload: %s\n" % exc)     sys.exit(2)  path = payload.get("tool_input", {}).get("file_path", "") or "" if not path:     sys.exit(0)  # normpath 는 선행 `//` 를 보존한다(POSIX). 축약을 먼저 해야 //etc 가 /etc 로 본다. # 주의: `{n,m}` 브레이스 수량자 금지 — 셸 브레이스 확장이 망가뜨린다(실측). # 셸/에이전트가 넘긴 경로에 따옴표가 섞여 있으면 제거한다 — `se"crets"/x` 는 # 실제로 `secrets/x` 다. 제거하지 않으면 성분 비교에서 빠진다. path = path.replace('"', "").replace("'", "") norm = posixpath.normpath(re.sub(r"//+", "/", path)) # 경로 경계 기준 비교 — /etc 는 막고 /etcd/config.yml 은 막지 않는다. for prot in ("/etc", "/sys", "/dev", "/boot", "/proc", "/root/.ssh"):     if norm == prot or norm.startswith(prot + "/"):         sys.stderr.write("guardrails: refusing write under %s\n" % prot)         sys.exit(2)  parts = norm.split("/") if ".git" in parts:     sys.stderr.write("guardrails: refusing write inside .git/\n")     sys.exit(2)  # 디렉토리 이름이 통째로 secret/credential 계열이면 그 아래 전부를 보호한다. # basename 만 보면 secrets/config.yml 이 통과한다(실측). 성분 "완전 일치" 라 # mysecrets-project/ 같은 무고한 이름은 그대로 통과한다. SECRET_DIRS = ("secret", "secrets", ".secret", ".secrets",                "credential", "credentials", ".credential", ".credentials") for part in parts:     if part.lower() in SECRET_DIRS:         sys.stderr.write("guardrails: refusing write under %s/\n" % part)         sys.exit(2)  base = posixpath.basename(norm) low = base.lower() if base == ".env" or base.startswith(".env."):     sys.stderr.write("guardrails: refusing write to %s\n" % base)     sys.exit(2) if "secret" in low or "credential" in low:     sys.stderr.write("guardrails: refusing write to %s\n" % base)     sys.exit(2) sys.exit(0) GUARD_EDIT )"
