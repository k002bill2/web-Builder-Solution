+++ b/src/features/pending/pendingConfirm.ts
@@ -0,0 +1,33 @@
+/** RS4 스파이크(측정 전용) — /projects 행 "다시 시도"·"저장 확인" 본문(조작 뒤 청크). 4.2·4.3 */
+import type { ProjectRepository } from "../../data/projectRepository";
+import { guarding, hold, release, type PendingRecord, type PendingStart } from "./pendingWrites";
+export { discardAndReload } from "./pendingWrites";
+
+const codeOf = (error: unknown) => (error as { code?: string } | undefined)?.code;
+const same = (a: { revision: number; candidateId: string; profileVersion: number } | undefined, b: { revision: number; candidateId: string; profileVersion: number }) =>
+  !!a && a.revision === b.revision && a.candidateId === b.candidateId && a.profileVersion === b.profileVersion;
+
+export async function confirmPending(repo: ProjectRepository, pending: PendingStart | PendingRecord): Promise<"confirmed" | "record" | "held" | "gone"> {
+  const { projectId } = pending;
+  return guarding(async () => {
+    try {
+      if (pending.kind === "record") await repo.deleteSnapshot(projectId, "");
+      else await repo.startDoc(projectId, pending.version, pending.selected, pending.mode, pending.origin.kind === "doc" ? pending.origin.head.revision : undefined);
+      release(repo, projectId, "confirmed");
+      return "confirmed";
+    } catch (error: unknown) {
+      if (pending.kind === "record") return "held";
+      const now = await repo.getDoc(projectId).catch(() => null);
+      const code = codeOf(error);
+      if (pending.origin.kind === "unknown" || now === null) return (hold(repo, { ...pending, held: "unknown" }), "held");
+      if (code === "STALE_DOC" || code === "DOC_EXISTS" || (pending.origin.kind === "doc" && same(now, pending.origin.head))) {
+        if (!now) return (release(repo, projectId, "not-applied-absent"), "gone");
+        hold(repo, { kind: "record", projectId, cause: "start-not-applied", head: now });
+        return "record";
+      }
+      if (pending.origin.kind === "absent" && !now) return (release(repo, projectId, "not-applied-absent"), "gone");
+      hold(repo, { ...pending, held: "unconfirmed" });
+      return "held";
+    }
+  });
+}
