+/**
+ * 이미지 슬롯 패널 로더 (SPEC m2c 2.1 — 조작 뒤 청크) — "이미지 편집" 버튼을 눌렀을 때만 받는다. 실패 뒤 다시 누르면 새 URL로 받는다(retryableImport, F1).
+ * 한 줄짜리 모듈로 떼어 둔 것은 화면 테스트가 로드 실패·요청 수를 주입·관찰하기 위해서다(exportFlowLoader와 같은 이유).
+ */
+import { retryableImport } from "../../data/chunkRetry";
+
+export const loadImageSlotPanel = retryableImport(() => import("./ImageSlotPanel"));
diff --git a/app/src/features/studio/images/store/types.ts b/app/src/features/studio/images/store/types.ts
new file mode 100644
index 0000000..10af92f
--- /dev/null
+++ b/app/src/features/studio/images/store/types.ts
@@ -0,0 +1,24 @@
+/**
+ * 이미지 보관소 계약 (SPEC m2c 2.6 · 7절 · 2a-05 5.9) — 진입 청크(StudioLayout·EditFields)는 이 타입만 import한다(`import type` = 번들 0).
+ * 구현(`imageStore.ts`)은 패널 청크와 함께 lazy로 받는다 — 보관소 모듈 자체는 진입에 import 금지(7절).
+ */
+import type { PageDoc } from "../../../../engine/contracts/pageDoc";
+import type { RenderImage } from "../../../../render/protocol";
+
+export type RenderImages = Readonly<Record<string, RenderImage>>;
+
+export interface ImageStoreHandle {
+  /** 참조 집합(현재 문서 ∪ 되돌릴 수 있는 이전 문서) 밖 항목을 해제한다 — object URL revoke 포함 */
+  readonly retain: (doc: PageDoc, undoDoc?: PageDoc) => void;
+  /** 편집기를 떠날 때 — 모든 URL 해제 · 보관소 비움 */
+  readonly dispose: () => void;
+}
+
+/** 편집 틀이 패널에 넘기는 보관소 자리 — 보관소는 패널이 처음 열릴 때 만들고, 수명은 편집 틀(언마운트 때 dispose) */
+export interface ImageHost {
+  readonly store: { current: ImageStoreHandle | undefined };
+  /** 캔버스로 보낼 images 맵 갱신 */
+  readonly publish: (images: RenderImages) => void;
+  /** 알림 줄 "되돌리기"가 되살릴 이전 문서(없으면 undefined) — 참조 집합에 넣는다 */
+  readonly undoDoc: PageDoc | undefined;
+}
