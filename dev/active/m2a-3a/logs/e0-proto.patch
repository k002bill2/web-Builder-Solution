@@ -0,0 +1,92 @@
+import type { GateReport, GateRowId, GateIssue } from "../../engine/contracts/records";
+
+const NAMES: Readonly<Record<GateRowId, string>> = {
+  contrast: "대비 AA",
+  "alt-text": "대체텍스트",
+  "heading-order": "헤딩 순서",
+  "required-sections": "필수 섹션",
+  "motion-budget": "모션 예산",
+  "seo-meta": "SEO 메타",
+  "text-length": "글자 수",
+  performance: "성능 예산",
+};
+const DOT = { pass: "bg-status-positive", warn: "bg-status-cautionary", block: "bg-status-negative", unmeasured: "bg-line-strong" } as const;
+const count = (report: GateReport, s: "block" | "warn") => report.rows.reduce((n, r) => n + r.issues.filter((i) => i.severity === s).length, 0);
+const word = (state: string, b: number, w: number) => (state === "unmeasured" ? "측정 전" : state === "block" ? `차단 ${b}` : state === "warn" ? `경고 ${w}` : "통과");
+
+export function GateList({ report, stale, onIssue }: { readonly report: GateReport | undefined; readonly stale: boolean; readonly onIssue: (issue: GateIssue, row: GateRowId) => void }) {
+  if (!report) return <p className="ds-caption1 text-label-alternative">검사하는 중</p>;
+  const b = count(report, "block");
+  const w = count(report, "warn");
+  const head = b + w === 0 ? "통과" : [b && `차단 ${b}`, w && `경고 ${w}`].filter(Boolean).join(" · ");
+  return (
+    <div className="flex flex-col gap-2">
+      <span className={`ds-caption1 rounded-sm px-2 py-0.5 ${b ? "bg-accent-red-bg text-accent-red" : w ? "bg-accent-orange-bg text-accent-orange" : "bg-accent-green-bg text-accent-green"}`}>{head}</span>
+      {stale && <p className="ds-caption1 text-label-alternative">편집 전 기준 결과입니다 · 다시 검사하는 중</p>}
+      <ul aria-busy={stale || undefined} className="flex flex-col gap-1">
+        {report.rows.map((row) => {
+          const rb = row.issues.filter((i) => i.severity === "block").length;
+          const rw = row.issues.length - rb;
+          const label = (
+            <>
+              <span aria-hidden="true" className={`size-2 rounded-full ${DOT[row.state]}`} />
+              <span className="ds-label">{NAMES[row.id]}</span>
+              <span className="ds-caption1">{word(row.state, rb, rw)}</span>
+            </>
+          );
+          const first = row.issues[0];
+          return (
+            <li key={row.id} className="flex flex-col gap-1">
+              {first ? (
+                <button type="button" onClick={() => onIssue(first, row.id)} className="flex min-h-8 items-center gap-2 rounded-sm px-2 text-left hover:bg-fill-normal">
+                  {label}
+                </button>
+              ) : (
+                <span className="flex min-h-8 items-center gap-2 px-2">{label}</span>
+              )}
+              <p className="ds-caption1 px-2 text-label-alternative">{first ? first.cause : row.state === "unmeasured" ? "생성기 연결 후 측정합니다" : ""}</p>
+              {row.issues.length > 0 && (
+                <details className="px-2">
+                  <summary className="ds-caption1 cursor-pointer">원인 · 대체안 {row.issues.length}건</summary>
+                  <ul className="ds-caption1 flex flex-col gap-1">
+                    {row.issues.map((i, n) => (
+                      <li key={n}>
+                        {i.ruleId} · {i.cause} · {i.alternative}
+                      </li>
+                    ))}
+                  </ul>
+                </details>
+              )}
+            </li>
+          );
+        })}
+      </ul>
+    </div>
+  );
+}
+
+export function ExportButtons({ reasons, onFirst, onExport, busy }: { readonly reasons: readonly { readonly id: string; readonly text: string; readonly link: string }[]; readonly onFirst: (i: number) => void; readonly onExport: (f: "react-zip" | "static-html") => void; readonly busy?: string }) {
+  const blocked = reasons.length > 0;
+  const describedBy = reasons.map((r) => r.id).join(" ") || undefined;
+  const btn = (f: "react-zip" | "static-html", text: string) => (
+    <button type="button" aria-disabled={blocked || undefined} aria-busy={busy === f || undefined} aria-describedby={describedBy} onClick={() => !blocked && onExport(f)} className="ds-label min-h-10 rounded-md border border-line-normal px-4 aria-disabled:text-label-disable">
+      {busy === f ? "내보내는 중…" : text}
+    </button>
+  );
+  return (
+    <div className="flex flex-col gap-2">
+      {btn("react-zip", "React 프로젝트(zip) 내보내기")}
+      {btn("static-html", "정적 HTML 내보내기")}
+      {blocked && (
+        <ul className="flex flex-col gap-1">
+          {reasons.map((r, i) => (
+            <li key={r.id}>
+              <p id={r.id} className="ds-caption1">{r.text}</p>
+              <button type="button" onClick={() => onFirst(i)} className="ds-label text-primary">{r.link}</button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
