+++ b/src/features/pending/pendingStudio.ts
@@ -0,0 +1,30 @@
+/** RS4 스파이크(측정 전용) S3 — 편집기 인계 본문(lazy). 진입 때 기억이 있을 때(자동·조건부) 또는 첫 편집 뒤(조작 뒤) 받는다 */
+import { hold, pendingOf, release, type Pending, type PendingRecord, type PendingStart } from "./pendingWrites";
+
+export { hold, release };
+type Repo = {
+  deleteSnapshot?(projectId: string, snapshotId: string): Promise<void>;
+  startDoc?(projectId: string, profileVersion: number, candidateId: string, mode: "create" | "restart", expectedRevision?: number): Promise<unknown>;
+};
+
+/** 5.3 저장 확인 — 스케줄러 버전과 묶는다(시작 때 버전 기록 → resolve면 해제, 버전 그대로면 saved) */
+export async function confirmIn(key: object, repo: Repo, projectId: string, ver: () => number, saved: () => void) {
+  const p = pendingOf(key, projectId);
+  if (!p || p.kind === "draft") return;
+  const v = ver();
+  try {
+    if (p.kind === "record") await repo.deleteSnapshot?.(projectId, "");
+    else await repo.startDoc?.(projectId, p.version, p.selected, p.mode, p.origin.kind === "doc" ? p.origin.head.revision : undefined);
+    release(key, projectId, "confirmed");
+    if (ver() === v) saved();
+  } catch {
+    // 4.3 사유 문형 — phase 유지
+  }
+}
+
+/** 3.3-5 떠날 때 draft — 진입 때 기억(under) 상속 · draft가 draft를 감싸지 않는다 */
+export function holdDraft(key: object, projectId: string, entry: Pending | undefined, doc: unknown, baseRevision: number) {
+  const now = pendingOf(key, projectId);
+  const under = (now?.kind === "draft" ? now.under : now) ?? (entry?.kind === "draft" ? entry.under : (entry as PendingStart | PendingRecord | undefined));
+  hold(key, { kind: "draft", projectId, doc, baseRevision, under });
+}
