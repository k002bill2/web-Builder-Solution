@@ -0,0 +1,116 @@
+import { lazy, Suspense, useCallback, useMemo, useState, type RefObject } from "react";
+import type { ProjectRepository, ProjectSnapshot } from "../../data/projectRepository";
+import type { PageDoc } from "../../engine/contracts/pageDoc";
+import { isPageDoc } from "../../features/studio/studioRepository";
+import type { UseDocSave } from "../../features/studio/useDocSave";
+import { Button } from "../ds/Button";
+
+/** 스냅샷 대화상자 · 미리보기 Callout(복원 흐름·편집 잠금 포함) — 조작 뒤 청크(ER-AC-S8) */
+const SnapshotDialog = lazy(() => import("./SnapshotDialog"));
+const SnapshotPreview = lazy(() => import("./SnapshotPreview"));
+export type Snapshot = ProjectSnapshot<PageDoc>;
+const BUTTON_ID = "studio-snapshot";
+const focusButton = () => document.getElementById(BUTTON_ID)?.focus();
+
+/**
+ * 스냅샷 연결(EDITOR-REST SPEC r1 3.2 · 7절) — 진입 직후 청크에는 툴바 버튼·상태·참조 집합만 둔다.
+ * 미리보기 중 = 캔버스가 스냅샷 문서 · 편집 입력 무시(자동 저장 0). 복원 = 저장 훅 경로(`save.adopt`) · 알림 줄 "되돌리기" 1건 =
+ * 복원 직전 문서를 새 편집으로(새 revision). 참조 집합 = 스냅샷 문서 전부 + 되돌릴 복원 직전 문서 — 목록은 생성·복원·내보내기·충돌 해결 뒤에만 읽는다.
+ */
+export function useSnapshots({
+  repository,
+  projectId,
+  save,
+  root,
+  heading,
+  onNotice,
+}: {
+  readonly repository: ProjectRepository;
+  readonly projectId: string;
+  readonly save: UseDocSave;
+  readonly root: RefObject<HTMLElement | null>;
+  readonly heading: RefObject<HTMLElement | null>;
+  readonly onNotice: (text: string) => void;
+}) {
+  const [open, setOpen] = useState(false);
+  const [preview, setPreview] = useState<Snapshot>();
+  const [held, setHeld] = useState<readonly PageDoc[]>([]);
+  const [undo, setUndo] = useState<{ readonly before: PageDoc; readonly after: PageDoc }>();
+  // 목록 읽기 실패는 참조 집합을 그대로 둔다(편집을 막지 않는다)
+  const refresh = useCallback(
+    () =>
+      void Promise.resolve()
+        .then(() => repository.listSnapshots(projectId))
+        .then((list) => setHeld(list.map((s) => s.doc).filter(isPageDoc)), () => undefined),
+    [repository, projectId],
+  );
+  const close = () => {
+    setPreview(undefined);
+    focusButton();
+  };
+  const kept = useMemo(() => (undo ? [...held, undo.before] : held), [held, undo]);
+  return {
+    preview,
+    refresh,
+    held: kept,
+    edit: preview ? () => undefined : save.edit,
+    onUndo:
+      undo?.after === save.doc
+        ? () => {
+            save.edit(undo.before);
+            setUndo(undefined);
+            onNotice("복원을 되돌렸습니다");
+            heading.current?.focus();
+          }
+        : undefined,
+    button: (
+      <Button id={BUTTON_ID} variant="outline" size="sm" className="flex-none" onClick={() => setOpen(true)}>
+        스냅샷
+      </Button>
+    ),
+    dialog: open && (
+      <Suspense fallback={null}>
+        <SnapshotDialog
+          repository={repository}
+          projectId={projectId}
+          flushed={save.flushed}
+          onCreated={(name) => {
+            onNotice(`스냅샷 '${name}'를 저장했습니다`);
+            refresh();
+          }}
+          // 저장 먼저 — 미리보기 중에는 자동 저장이 나가지 않게(ER-AC-S3)
+          onPreview={(snapshot) =>
+            void save.flushed().then(() => {
+              setOpen(false);
+              setPreview(snapshot);
+            })
+          }
+          onClose={() => {
+            setOpen(false);
+            focusButton();
+          }}
+        />
+      </Suspense>
+    ),
+    callout: preview && (
+      <Suspense fallback={null}>
+        <SnapshotPreview
+          key={preview.snapshotId}
+          snapshot={preview}
+          root={root}
+          save={save}
+          repository={repository}
+          projectId={projectId}
+          onBack={close}
+          onRestored={(before, after, text) => {
+            setPreview(undefined);
+            setUndo({ before, after });
+            onNotice(text);
+            refresh();
+            heading.current?.focus();
+          }}
+        />
+      </Suspense>
+    ),
+  };
+}
