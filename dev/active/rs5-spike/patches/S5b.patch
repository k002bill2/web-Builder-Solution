@@ -0,0 +1,23 @@
+/**
+ * RS5 스파이크 — 편집기 seed 인계(CONTRACT-5 8.2 3행). 제품 구현 아님 · 측정 뒤 원복.
+ * 미확인 초안 → 편집 문서·이미지 binding·phase 미확인 상속(자동 저장 1회) · 교체 충돌(I3b) → 선택 전 저장 0(최신 문서만 보관 — 충돌 UI 배선 없음)
+ */
+import type { LedgerView } from "../../data/saveLedger";
+import type { PageDoc } from "../../engine/contracts/pageDoc";
+import type { RenderImages } from "./images/store/types";
+
+export interface SeedTarget {
+  readonly doc: (doc: PageDoc) => void;
+  readonly images: (images: RenderImages) => void;
+  readonly change: (doc: PageDoc) => void;
+  readonly conflict: (theirs: PageDoc) => void;
+}
+
+export function applySeed(seed: LedgerView, to: SeedTarget) {
+  if (seed.conflicted) return to.conflict(seed.conflicted as PageDoc);
+  if (!seed.latest) return;
+  const doc = seed.latest.doc as PageDoc;
+  to.images(seed.latest.images);
+  to.doc(doc);
+  to.change(doc);
+}
