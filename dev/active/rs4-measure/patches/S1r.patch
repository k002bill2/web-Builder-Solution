diff --git a/src/features/pending/pendingWrites.ts b/src/features/pending/pendingWrites.ts
new file mode 100644
index 0000000..05653c0
--- /dev/null
+++ b/src/features/pending/pendingWrites.ts
@@ -0,0 +1,90 @@
+/** RS4 스파이크(측정 전용) — 미확인 기억 · 탭 수명 · 기억에 붙는 beforeunload (SPEC-4 3절). 런타임 import 0 */
+import type { DocHead } from "../../data/projectRepository";
+
+export type Origin = { readonly kind: "absent" } | { readonly kind: "doc"; readonly head: DocHead } | { readonly kind: "unknown" };
+export interface PendingStart {
+  readonly kind: "start";
+  readonly mode: "create" | "restart";
+  readonly projectId: string;
+  readonly version: number;
+  readonly selected: string;
+  readonly origin: Origin;
+  readonly held: "unconfirmed" | "unknown";
+}
+export interface PendingRecord {
+  readonly kind: "record";
+  readonly projectId: string;
+  readonly cause: "start-not-applied";
+  readonly head?: DocHead;
+}
+export interface PendingDraft {
+  readonly kind: "draft";
+  readonly projectId: string;
+  readonly doc: unknown;
+  readonly baseRevision: number;
+  readonly images?: unknown;
+  readonly under?: PendingStart | PendingRecord;
+}
+export type Pending = PendingStart | PendingRecord | PendingDraft;
+
+/** 감량 1회(측정): /projects가 이 모듈을 정적 import하지 않고 같은 표를 동기 조회하도록 전역 키에 둔다(공유 청크 = index mapDeps +20B 회피) */
+export const PENDING_KEY = Symbol.for("design-studio.pending");
+const memory = ((globalThis as Record<symbol, unknown>)[PENDING_KEY] ??= new WeakMap<object, Map<string, Pending>>()) as WeakMap<object, Map<string, Pending>>;
+const seqs = new WeakMap<object, number>();
+let seq = 0;
+let active: ReadonlySet<string> = new Set();
+let inflight = 0;
+let attached = false;
+
+const onUnload = (e: BeforeUnloadEvent) => {
+  e.preventDefault();
+  e.returnValue = "";
+};
+const sync = () => {
+  const want = active.size + inflight > 0;
+  if (want === attached) return;
+  attached = want;
+  if (want) window.addEventListener("beforeunload", onUnload);
+  else window.removeEventListener("beforeunload", onUnload);
+};
+const keyOf = (repo: object, projectId: string) => {
+  if (!seqs.has(repo)) seqs.set(repo, ++seq);
+  return `${seqs.get(repo)}:${projectId}`;
+};
+
+export const pendingOf = (repo: object, projectId: string): Pending | undefined => memory.get(repo)?.get(projectId);
+
+export function hold(repo: object, pending: Pending) {
+  const map = memory.get(repo) ?? new Map<string, Pending>();
+  memory.set(repo, map.set(pending.projectId, pending));
+  active = new Set(active).add(keyOf(repo, pending.projectId));
+  sync();
+}
+
+export function release(repo: object, projectId: string, why: "confirmed" | "not-applied-absent" | "discarded") {
+  void why;
+  memory.get(repo)?.delete(projectId);
+  const key = keyOf(repo, projectId);
+  active = new Set([...active].filter((k) => k !== key));
+  sync();
+}
+
+/** 진행 중 요청 보호 — 시작 +1 · 끝 -1. 판정이 기억이면 hold가 finally보다 먼저(카운트가 0을 거치지 않음) */
+export async function guarding<T>(work: () => Promise<T>): Promise<T> {
+  inflight += 1;
+  sync();
+  try {
+    return await work();
+  } finally {
+    inflight -= 1;
+    sync();
+  }
+}
+
+/** 사용자 명시 폐기(5.5) — 리스너 먼저 떼고 새로고침 */
+export function discardAndReload() {
+  active = new Set();
+  inflight = 0;
+  sync();
+  location.reload();
+}
