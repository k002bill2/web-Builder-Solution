diff --git a/app/src/pages/ProfileVersionNarrow.test.tsx b/app/src/pages/ProfileVersionNarrow.test.tsx
new file mode 100644
index 0000000..a5c2690
--- /dev/null
+++ b/app/src/pages/ProfileVersionNarrow.test.tsx
@@ -0,0 +1,120 @@
+/**
+ * FIX-2A04b2 F3 — 좁은 폭 버전 비교·버전 줄 (DS-CHECK-01 A-03·A-04·A-05 = D-2A4-05).
+ * <768은 표 대신 필드별 dl(항목 → vA → vB → "바뀜"), 768 이상은 표(항목·차이 열 줄바꿈 없음 · 단어 단위).
+ * 한 번에 한 배치만 DOM에 그린다(중복 낭독 금지) — jsdom에는 matchMedia가 없어 Tailwind 폭으로 흉내 낸다.
+ */
+import { cleanup, screen, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, describe, expect, it } from "vitest";
+import { createMemoryStudio } from "../data/memoryStudio";
+import { createMemoryReferenceRepository } from "../data/referenceRepository";
+import { referenceDetailFixtures } from "../fixtures/referenceDetails";
+import { referenceFixtures } from "../fixtures/references";
+import { FIXTURE_CATALOG, boardOf } from "../test/compareFixtures";
+import { renderApp } from "../test/renderApp";
+
+const THREE = ["ref-a", "ref-b", "ref-c"];
+const original = window.matchMedia;
+
+function setViewport(width: number) {
+  window.matchMedia = ((query: string) => {
+    const min = Number(/min-width:\s*([\d.]+)rem/.exec(query)?.[1] ?? 0) * 16;
+    return {
+      matches: width >= min,
+      media: query,
+      onchange: null,
+      addEventListener: () => {},
+      removeEventListener: () => {},
+      addListener: () => {},
+      removeListener: () => {},
+      dispatchEvent: () => false,
+    } as MediaQueryList;
+  }) as typeof window.matchMedia;
+}
+
+/** v1 확정 → 대표색 ref-c로 v2 → 전부 ref-b로 v3 (v1↔v3에 바뀐 줄과 같은 줄이 섞인다) */
+async function openAt(width: number, path: string) {
+  setViewport(width);
+  const studio = createMemoryStudio({ catalog: FIXTURE_CATALOG, initialBoard: boardOf(THREE, { hero: "ref-a" }) });
+  await studio.board.confirmProfile(1, 0);
+  for (const [latest, picks] of [[1, { palette: "ref-c" }], [2, { hero: "ref-b", palette: "ref-b", font: "ref-b" }]] as const) {
+    const { board } = await studio.board.getBoard();
+    const changed = await studio.board.savePicks({ ...board.picks, ...picks }, board.custom, board.revision);
+    await studio.board.createProfileVersion("profile-1", changed.revision, latest);
+  }
+  const view = renderApp(path, createMemoryReferenceRepository(referenceFixtures, referenceDetailFixtures), studio.board, studio.profiles);
+  await screen.findByRole("heading", { level: 1, name: "디자인 프로필" });
+  return view;
+}
+
+/** 어느 배치든 [항목, vA 값, vB 값, 바뀜] 목록으로 읽는다 — 두 배치의 정보가 같은지 비교 */
+function readDiff(): string[][] {
+  const table = screen.queryByRole("table");
+  if (table) {
+    return within(table)
+      .getAllByRole("row")
+      .slice(1)
+      .map((tr) => [...tr.children].map((c) => c.textContent ?? ""));
+  }
+  const figure = screen.getByRole("figure", { name: "v1과 v3 비교" });
+  return [...figure.querySelectorAll("dl > div")].map((group) => {
+    const [a, b, mark] = [...group.querySelectorAll("dd")].map((dd) => dd.lastChild?.textContent ?? "");
+    return [group.querySelector("dt")?.textContent ?? "", a ?? "", b ?? "", mark ?? ""];
+  });
+}
+
+afterEach(() => {
+  window.matchMedia = original;
+});
+
+describe("F3 버전 비교 — 폭별 배치 (A-03·A-04)", () => {
+  it("768: 표 · 항목(열·행 머리글)·차이 열은 줄바꿈 없음, 값은 단어 단위 · dl 없음", async () => {
+    await openAt(768, "/profile/profile-1?v=1&diff=3");
+    const table = await screen.findByRole("table", { name: "v1과 v3 비교" });
+    expect(table).toHaveClass("break-keep");
+    const [item, , , change] = within(table).getAllByRole("columnheader");
+    expect(item).toHaveClass("whitespace-nowrap");
+    expect(change).toHaveClass("whitespace-nowrap");
+    for (const th of within(table).getAllByRole("rowheader")) expect(th).toHaveClass("whitespace-nowrap");
+    expect(screen.queryByRole("figure")).not.toBeInTheDocument();
+    expect(table.closest(".rounded-md")?.querySelector("dl")).toBeNull();
+  });
+
+  it.each([390, 320])("%i: 표 대신 필드별 dl(항목 → v1 → v3 → 바뀜) · 정보는 768 표와 같다 · 제목 1번만", async (width) => {
+    await openAt(768, "/profile/profile-1?v=1&diff=3");
+    await screen.findByRole("table", { name: "v1과 v3 비교" });
+    const wide = readDiff();
+    cleanup();
+
+    await openAt(width, "/profile/profile-1?v=1&diff=3");
+    const figure = await screen.findByRole("figure", { name: "v1과 v3 비교" });
+    expect(screen.queryByRole("table")).not.toBeInTheDocument();
+    expect(readDiff()).toEqual(wide);
+    expect(wide.some((r) => r[3] === "바뀜") && wide.some((r) => r[3] === "")).toBe(true);
+    // 값마다 어느 버전인지 글자로 붙는다(열 머리글 대신)
+    const first = figure.querySelector("dl > div")!;
+    expect([...first.querySelectorAll("dd")].slice(0, 2).map((dd) => dd.firstChild?.textContent)).toEqual(["v1", "v3"]);
+    // 중복 낭독 없음: 제목·항목 이름이 한 번씩만 DOM에 있다
+    expect(screen.getAllByText("v1과 v3 비교")).toHaveLength(1);
+    for (const [label] of wide) expect(within(figure).getAllByText(label!)).toHaveLength(1);
+  });
+
+  it("390: ?v=1에서 'v1과 비교 (v3)' → 비교 제목(figcaption)에 포커스 · 닫기 → 같은 버튼 (P-AC-09)", async () => {
+    await openAt(390, "/profile/profile-1?v=1");
+    await userEvent.click(screen.getByRole("button", { name: "v1과 비교 (v3)" }));
+    const figure = await screen.findByRole("figure", { name: "v1과 v3 비교" });
+    expect(figure.querySelector("figcaption")).toHaveFocus();
+    await userEvent.click(screen.getByRole("button", { name: "비교 닫기" }));
+    expect(screen.getByRole("button", { name: "v1과 비교 (v3)" })).toHaveFocus();
+  });
+});
+
+describe("F3 버전 줄 요약 (A-05)", () => {
+  it("<768은 요약이 줄 전체 폭 둘째 줄(basis-full), 768부터 남은 폭(md:flex-1)", async () => {
+    await openAt(390, "/profile/profile-1");
+    const row = screen.getByRole("listitem", { name: /^v2 / });
+    const summary = within(row).getByText(/외 \d+$|·/, { selector: "span.ds-caption1" });
+    expect(summary).toHaveClass("basis-full", "md:basis-auto", "md:flex-1");
+    expect(summary).not.toHaveClass("flex-1");
+  });
+});
