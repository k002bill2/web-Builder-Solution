+++ b/app/src/data/chunkRetry.ts
@@ -0,0 +1,22 @@
+/**
+ * 조작 뒤 청크 로더 (FIX-2A04b2 F1 · QA D-2A4-01·02). 브라우저는 실패한 동적 import를 URL 단위로 기억해,
+ * 네트워크가 돌아와도 같은 import()는 요청 없이 거부한다(Chromium 실측) — 그래서 "다시 시도"는 같은 청크를 새 URL로 받는다.
+ *  - 첫 시도는 정적 `import()` 그대로(번들 manifest·분류 유지). 받은 모듈은 기억해 다시 받지 않는다(새 URL로 받은 뒤 정적 import()는 계속 실패).
+ *  - 새 URL = 실패 오류 문장 속 **같은 출처 + `<base>assets/<청크>-<해시>.js`**를 여기서 다시 조립한 값 + `?retry=N`(N은 매번 증가).
+ *    그 밖의 URL은 쓰지 않는다(임의 URL import 금지) — 원래 오류를 그대로 던지고 다음에도 정적 import()를 부른다
+ *    (URL 없는 WebKit 문장·개발 서버 `/src/…`·Vitest 모두 이 경로 = 지금과 같다).
+ * 진입 직후 청크에 붙으므로(ADR-004 여유) 짧게 둔다.
+ */
+export function retryableImport<M>(chunk: string, load: () => Promise<M>, importUrl = (url: string): Promise<M> => import(/* @vite-ignore */ url)) {
+  const prefix = `${location.origin}${import.meta.env.BASE_URL}assets/${chunk}-`;
+  let loaded: Promise<M> | undefined;
+  let url = "";
+  let retries = 0;
+  return (): Promise<M> =>
+    (loaded ??= (url ? importUrl(`${url}?retry=${++retries}`) : load()).catch((error: unknown) => {
+      loaded = undefined;
+      const file = /^[\w-]+\.js\b/.exec(String((error as Error | undefined)?.message).split(prefix)[1] ?? "")?.[0];
+      url ||= file ? prefix + file : "";
+      throw error;
+    }));
+}
