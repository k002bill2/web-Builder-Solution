+++ b/app/src/data/chunkRetry.test.ts
@@ -0,0 +1,92 @@
+/**
+ * FIX-2A04b2 F1 (D-2A4-01·02) — 조작 뒤 청크 로더. 브라우저는 실패한 동적 import를 URL 단위로 기억한다(같은 import()는 요청 없이 거부).
+ * 첫 시도는 정적 import(), 실패 뒤엔 같은 청크를 새 URL(`?retry=N`)로 받는다 — 같은 출처 + 빌드 자산 경로(`/assets/<청크>-<해시>.js`)만.
+ */
+import { describe, expect, it, vi } from "vitest";
+import { retryableImport } from "./chunkRetry";
+
+const ASSET = `${location.origin}/assets/memoryBoardConfirm-DCU0aP35.js`;
+const chromium = (url: string) => new TypeError(`Failed to fetch dynamically imported module: ${url}`);
+const MODULE = Object.freeze({ ok: true });
+
+/** 브라우저 흉내 — 정적 import()는 한 번 실패하면 계속 실패(실패 캐시), 새 URL만 실제로 받는다 */
+function browser(error: unknown = chromium(ASSET)) {
+  const load = vi.fn(() => Promise.reject(error));
+  const fresh = vi.fn((url: string) => (url.includes("?retry=") ? Promise.resolve(MODULE) : Promise.reject(error)));
+  return { load, fresh, loader: retryableImport("memoryBoardConfirm", load, fresh) };
+}
+
+describe("retryableImport — 실패 캐시 우회", () => {
+  it("첫 시도는 정적 import() 1회, 성공하면 모듈을 기억해 다시 받지 않는다", async () => {
+    const load = vi.fn(() => Promise.resolve(MODULE));
+    const fresh = vi.fn();
+    const loader = retryableImport("memoryBoardConfirm", load, fresh);
+    await expect(loader()).resolves.toBe(MODULE);
+    await expect(loader()).resolves.toBe(MODULE);
+    expect(load).toHaveBeenCalledTimes(1);
+    expect(fresh).not.toHaveBeenCalled();
+  });
+
+  it("정적 import()가 실패하면 원래 오류 그대로 거부 → 다시 부르면 같은 청크를 새 URL(?retry=1)로 받아 성공, 그 뒤 요청 0", async () => {
+    const error = chromium(ASSET);
+    const { load, fresh, loader } = browser(error);
+    await expect(loader()).rejects.toBe(error);
+    await expect(loader()).resolves.toBe(MODULE);
+    expect(fresh).toHaveBeenCalledWith(`${ASSET}?retry=1`);
+    await expect(loader()).resolves.toBe(MODULE);
+    expect(load).toHaveBeenCalledTimes(1);
+    expect(fresh).toHaveBeenCalledTimes(1);
+  });
+
+  it("새 URL도 실패하면 다음엔 번호를 올린다(?retry=2) — 실패한 ?retry=1도 캐시되므로", async () => {
+    const error = chromium(ASSET);
+    const load = vi.fn(() => Promise.reject(error));
+    const fresh = vi.fn().mockRejectedValueOnce(chromium(`${ASSET}?retry=1`)).mockResolvedValueOnce(MODULE);
+    const loader = retryableImport("memoryBoardConfirm", load, fresh);
+    await expect(loader()).rejects.toBe(error);
+    await expect(loader()).rejects.toThrow("?retry=1");
+    await expect(loader()).resolves.toBe(MODULE);
+    expect(fresh.mock.calls.map(([url]) => url)).toEqual([`${ASSET}?retry=1`, `${ASSET}?retry=2`]);
+    expect(load).toHaveBeenCalledTimes(1);
+  });
+
+  it("Firefox 문장(error loading dynamically imported module: URL)도 같은 청크 URL로 읽는다", async () => {
+    const { fresh, loader } = browser(new TypeError(`error loading dynamically imported module: ${ASSET}`));
+    await loader().catch(() => {});
+    await loader();
+    expect(fresh).toHaveBeenCalledWith(`${ASSET}?retry=1`);
+  });
+
+  it.each([
+    ["다른 출처", "https://evil.example/assets/memoryBoardConfirm-DCU0aP35.js"],
+    ["같은 출처 · 빌드 자산 밖(개발 서버 /src)", `${location.origin}/src/data/memoryBoardConfirm.ts`],
+    ["같은 출처 · 빌드 자산 밖(/api)", `${location.origin}/api/memoryBoardConfirm-DCU0aP35.js`],
+    ["같은 출처 · 다른 청크", `${location.origin}/assets/memoryStudio-DcNPQb-K.js`],
+    ["같은 출처 · 경로 끼워 넣기", `${location.origin}/assets/memoryBoardConfirm-x/../../evil.js`],
+    ["userinfo로 출처 속이기", `${location.origin}@evil.example/assets/memoryBoardConfirm-DCU0aP35.js`],
+  ])("%s URL은 쓰지 않는다 — 원래 오류 그대로, 다음 시도도 정적 import()", async (_, url) => {
+    const error = chromium(url);
+    const { load, fresh, loader } = browser(error);
+    await expect(loader()).rejects.toBe(error);
+    await expect(loader()).rejects.toBe(error);
+    expect(load).toHaveBeenCalledTimes(2);
+    expect(fresh).not.toHaveBeenCalled();
+  });
+
+  it("URL이 없는 오류(WebKit 'Importing a module script failed.'·Error 아닌 값)는 그대로 던지고 정적 import()를 다시 부른다", async () => {
+    for (const error of [new TypeError("Importing a module script failed."), "offline"]) {
+      const { load, fresh, loader } = browser(error);
+      await expect(loader()).rejects.toBe(error);
+      await expect(loader()).rejects.toBe(error);
+      expect(load).toHaveBeenCalledTimes(2);
+      expect(fresh).not.toHaveBeenCalled();
+    }
+  });
+
+  it("같은 시점의 겹친 호출은 요청 하나를 나눠 받는다", async () => {
+    const load = vi.fn(() => Promise.resolve(MODULE));
+    const loader = retryableImport("memoryBoardConfirm", load, vi.fn());
+    await Promise.all([loader(), loader()]);
+    expect(load).toHaveBeenCalledTimes(1);
+  });
+});
