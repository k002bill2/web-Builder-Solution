+// @vitest-environment node
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterAll, describe, expect, it } from "vitest";
+import { crc32, storeZip, zipParts, type ZipEntry } from "./storeZip";
+
+const dir = mkdtempSync(join(tmpdir(), "m4a-zip-"));
+afterAll(() => rmSync(dir, { recursive: true, force: true }));
+const enc = new TextEncoder();
+const bytesOf = (parts: Uint8Array[]) => new Uint8Array(Buffer.concat(parts));
+
+/** 순수 파서 — EOCD → 중앙 디렉터리 → 로컬 헤더 → 본문 · CRC 재계산 */
+function parse(zip: Uint8Array) {
+  const v = new DataView(zip.buffer, zip.byteOffset, zip.byteLength);
+  const e = zip.length - 22;
+  expect(v.getUint32(e, true)).toBe(0x06054b50);
+  const count = v.getUint16(e + 10, true);
+  let at = v.getUint32(e + 16, true);
+  const out: { name: string; flags: number; method: number; data: Uint8Array }[] = [];
+  for (let i = 0; i < count; i++) {
+    expect(v.getUint32(at, true)).toBe(0x02014b50);
+    const flags = v.getUint16(at + 8, true);
+    const method = v.getUint16(at + 10, true);
+    const crc = v.getUint32(at + 16, true);
+    const size = v.getUint32(at + 20, true);
+    const nameLen = v.getUint16(at + 28, true);
+    const local = v.getUint32(at + 42, true);
+    const name = new TextDecoder().decode(zip.subarray(at + 46, at + 46 + nameLen));
+    expect(v.getUint32(local, true)).toBe(0x04034b50);
+    const start = local + 30 + v.getUint16(local + 26, true) + v.getUint16(local + 28, true);
+    const data = zip.subarray(start, start + size);
+    expect(crc32(data)).toBe(crc);
+    out.push({ name, flags, method, data });
+    at += 46 + nameLen;
+  }
+  return out;
+}
+
+const sample: ZipEntry[] = [
+  { name: "index.html", data: enc.encode("<!doctype html><title>안녕</title>") },
+  { name: "assets/images/0a1b2c3d-1k.webp", data: new Uint8Array(4096).map((_, i) => (i * 31) & 0xff) },
+  { name: "assets/fonts/KitSansKR-400.woff2", data: new Uint8Array(0) },
+  { name: "한글 이름.txt", data: enc.encode("본문") },
+];
+
+describe("storeZip (M4-a-1 S1)", () => {
+  it("CRC-32 표준 벡터", () => {
+    expect(crc32(enc.encode("123456789"))).toBe(0xcbf43926);
+    expect(crc32(new Uint8Array(0))).toBe(0);
+  });
+
+  it("순수 파서 — 항목·UTF-8 플래그·store·CRC 일치", () => {
+    const entries = parse(bytesOf(zipParts(sample, new Date(2026, 9, 18, 12, 30, 10))));
+    expect(entries.map((e) => e.name)).toEqual(sample.map((e) => e.name));
+    for (const [i, e] of entries.entries()) {
+      expect(e.flags).toBe(0x0800);
+      expect(e.method).toBe(0);
+      expect(Buffer.from(e.data).equals(Buffer.from(sample[i]!.data))).toBe(true);
+    }
+  });
+
+  it("빈 목록 = EOCD 22바이트", () => {
+    expect(bytesOf(zipParts([])).length).toBe(22);
+  });
+
+  it("unzip -t · zipinfo · unzip -p · ditto -x -k(macOS Archive Utility 엔진 근사)로 연다", async () => {
+    const file = join(dir, "site.zip");
+    writeFileSync(file, Buffer.from(await storeZip(sample, new Date(2026, 9, 18, 12, 30, 10)).arrayBuffer()));
+    expect(execFileSync("unzip", ["-t", file]).toString()).toContain("No errors detected");
+    const info = execFileSync("zipinfo", [file]).toString();
+    expect(info).toContain("4 files");
+    expect(info).toContain("stor");
+    expect(execFileSync("unzip", ["-p", file, "index.html"]).toString()).toBe("<!doctype html><title>안녕</title>");
+    const out = join(dir, "ditto");
+    execFileSync("ditto", ["-x", "-k", file, out]);
+    expect(readFileSync(join(out, "assets/images/0a1b2c3d-1k.webp")).equals(Buffer.from(sample[1]!.data))).toBe(true);
+    expect(readFileSync(join(out, "한글 이름.txt"), "utf8")).toBe("본문");
+  });
+
+  it("경로 검사 — 앞 / · .. · \\ · 빈 이름은 실패", () => {
+    for (const name of ["/a", "../a", "a/../b", "a\\b", ""]) expect(() => zipParts([{ name, data: new Uint8Array(1) }])).toThrow();
+    expect(() => zipParts([{ name: "a..b/c.txt", data: new Uint8Array(1) }])).not.toThrow();
+  });
+});
