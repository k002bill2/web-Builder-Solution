+/**
+ * 이미지 분리 (M4-a-1 스파이크 S2) — 정적 HTML 마크업(불활성 문서의 사이트 루트)의 `img src="data:image/…;base64,"`를
+ * `assets/images/<hash>.<ext>` 참조로 바꾸고 파일 목록을 돌려준다. 해시 = CRC-32 8자리 + 바이트 길이(동기 · 같은 바이트는 1개 파일).
+ * 렌더 문서는 그대로(data URL 직렬화) — 부모 쪽(조작 뒤 청크)만 바뀐다.
+ */
+import { crc32, type ZipEntry } from "./storeZip";
+
+const DATA_IMAGE = /^data:image\/(webp|jpeg|png);base64,/;
+
+const fromBase64 = (text: string) => {
+  const binary = atob(text);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+  return bytes;
+};
+
+export function splitImages(site: Element): ZipEntry[] {
+  const files = new Map<string, Uint8Array>();
+  for (const img of site.querySelectorAll("img")) {
+    const src = img.getAttribute("src") ?? "";
+    const type = DATA_IMAGE.exec(src)?.[1];
+    if (!type) continue;
+    const data = fromBase64(src.slice(src.indexOf(",") + 1));
+    const name = `assets/images/${crc32(data).toString(16).padStart(8, "0")}-${data.length.toString(36)}.${type === "jpeg" ? "jpg" : type}`;
+    files.set(name, data);
+    img.setAttribute("src", name);
+  }
+  return [...files].map(([name, data]) => ({ name, data }));
+}
