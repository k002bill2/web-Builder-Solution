+import { describe, expect, it } from "vitest";
+import { splitImages } from "./splitImages";
+
+const b64 = (bytes: number[]) => btoa(String.fromCharCode(...bytes));
+
+describe("splitImages (M4-a-1 S2)", () => {
+  it("data: img → assets/images/<crc>-<len>.<ext> · 같은 바이트는 1개 파일 · data: 아닌 src는 그대로", () => {
+    const page = document.implementation.createHTMLDocument("");
+    page.body.innerHTML = `<div data-site-root><img src="data:image/webp;base64,${b64([1, 2, 3])}"><img src="data:image/jpeg;base64,${b64([9, 9])}"><img src="data:image/webp;base64,${b64([1, 2, 3])}"><img src="x.png"></div>`;
+    const site = page.body.firstElementChild!;
+    const files = splitImages(site);
+    expect(files.map((f) => f.name)).toEqual([expect.stringMatching(/^assets\/images\/[0-9a-f]{8}-3\.webp$/), expect.stringMatching(/^assets\/images\/[0-9a-f]{8}-2\.jpg$/)]);
+    expect([...files[0]!.data]).toEqual([1, 2, 3]);
+    const srcs = [...site.querySelectorAll("img")].map((img) => img.getAttribute("src"));
+    expect(srcs).toEqual([files[0]!.name, files[1]!.name, files[0]!.name, "x.png"]);
+  });
+});
