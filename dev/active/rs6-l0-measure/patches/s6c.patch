+ */
+import { hashDoc } from "../../../engine/ops/hash";
+import type { PageDoc } from "../../../engine/contracts/pageDoc";
+import type { RenderImages } from "../images/store/types";
+import type { CoreIo, CoreLink, CoreState, Receipt, SaveResult } from "./saveCore";
+
+const reasonOf = (error: unknown) => (error as { code?: string })?.code ?? String((error as Error)?.message);
+
+async function saveNow(s: CoreState, link: CoreLink, projectId: string): Promise<SaveResult> {
+  // CE-2: 제출 doc·바인딩·mark를 같은 동기 구간에서 동결
+  const target = s.doc;
+  const bound = s.attached;
+  const submitted = s.mark;
+  const newer = () => s.mark > submitted;
+  const base = s.confirmed?.revision ?? target.revision;
+  const next: PageDoc = Object.freeze({ ...target, revision: base + 1, hash: hashDoc(target) });
+  if (!link.port) {
+    try {
+      link.book(target, base);
+    } catch (error) {
+      return { status: "failed", reason: reasonOf(error), newer: newer() };
+    }
+    return { status: "failed", reason: "not-persistent", newer: newer() };
+  }
+  const mode = await link.port.mode();
+  if (mode !== "writer") return { status: "failed", reason: mode, newer: newer() };
+  try {
+    await link.port.commit(projectId, next, bound);
+  } catch (error) {
+    return { status: "failed", reason: reasonOf(error), newer: newer() };
+  }
+  const receipt: Receipt = { hash: next.hash, revision: next.revision, mark: submitted, proof: "committed" };
+  s.savedMark = Math.max(s.savedMark, submitted);
+  s.confirmed = receipt;
+  s.committed = bound;
+  // saved 뒤 DocBook 맞춤(G1) — 실패면 IDB는 이미 커밋, 메모리만 다음 저장이 맞춘다
+  try {
+    link.book(target, base);
+  } catch {
+    /* 다른 화면 메모리 머리 맞춤 실패 — 저장 결과는 saved */
+  }
+  return { status: "saved", receipt, newer: newer() };
+}
+
+export const coreIo: CoreIo = {
+  save: saveNow,
+  async confirm(s, link, projectId, save) {
+    if (!link.port) return { status: "failed", reason: "not-persistent" };
+    const entered = s.mark;
+    if (s.mark <= s.savedMark && s.confirmed) {
+      const mode = await link.port.mode();
+      if (mode !== "writer") return { status: "failed", reason: mode };
+      const proof = s.confirmed;
+      if (!(await link.port.verify(projectId, proof))) return { status: "failed", reason: "stale" };
+      if (s.mark !== entered) return { status: "newer", receipt: { ...proof, proof: "fresh" } };
+      return { status: "confirmed", wrote: false, receipt: { ...proof, proof: "fresh" } };
+    }
+    const result = await save();
+    if (result.status === "failed") return { status: "failed", reason: result.reason };
+    if (!(await link.port.verify(projectId, result.receipt))) return { status: "failed", reason: "not-committed" };
+    if (s.mark > result.receipt.mark) return { status: "newer", receipt: result.receipt };
+    return { status: "confirmed", wrote: true, receipt: result.receipt };
+  },
+  async discard(s, link, projectId) {
+    if (s.discarding) return { status: "rejected", reason: "discarding" };
+    if (s.inflight > 0) return { status: "rejected", reason: "inflight" };
+    if (!link.port) return { status: "blocked", reason: "not-persistent" };
+    const proof = s.confirmed;
+    if (!proof) return { status: "blocked", reason: "no-saved-state" };
+    s.discarding = true;
+    try {
+      const entered = s.mark;
+      const head = await link.port.head(projectId);
+      if (!head || !(await link.port.verify(projectId, proof))) return { status: "blocked", reason: "stale" };
+      if (s.mark !== entered) return { status: "blocked", reason: "newer" };
+      const stored = await link.port.stored(projectId);
+      if (!stored) return { status: "blocked", reason: "stale" };
+      s.doc = stored;
+      // CX-3: 바인딩 = 복귀 문서 커밋 때 실린 이미지만
+      s.attached = s.committed;
+      s.savedMark = s.mark;
+      s.epoch += 1;
+      return { status: "discarded", restored: { ...proof, proof: "fresh" } };
+    } finally {
+      s.discarding = false;
+    }
+  },
+  replace(s, next, request, blobs?: RenderImages) {
+    if (request.intent !== "replace") return { status: "rejected", reason: "intent-required" };
+    if (s.inflight > 0) return { status: "rejected", reason: "inflight" };
+    if (s.mark > s.savedMark) return { status: "rejected", reason: "dirty" };
+    if (request.expectedEpoch !== s.epoch) return { status: "rejected", reason: "epoch" };
+    s.doc = next;
+    if (blobs) s.attached = { ...s.attached, ...blobs };
+    s.mark += 1;
+    s.epoch += 1;
+    return { status: "replaced", epoch: s.epoch };
+  },
+};
diff --git a/app/src/features/studio/save/saveCore.ts b/app/src/features/studio/save/saveCore.ts
new file mode 100644
index 00000000..960fdef3
--- /dev/null
+++ b/app/src/features/studio/save/saveCore.ts
@@ -0,0 +1,108 @@
+/**
+ * 저장 코어 상태 부분(INTEGRATE-6 9.2 진입 몫) — 초안·mark·바인딩·epoch·lease·직렬 chain. 동기 생성(2.2-2 ①).
+ * io(save 본문·confirm·discard·replace·verify)와 포트는 조작 뒤 청크 — `connect()`가 받는다(값 import 0, 타입만).
+ */
+import type { PageDoc } from "../../../engine/contracts/pageDoc";
+import type { RenderImages } from "../images/store/types";
+
+export interface Receipt {
+  readonly hash: string;
+  readonly revision: number;
+  readonly mark: number;
+  readonly proof: "hydrated" | "committed" | "fresh";
+}
+export type SaveResult = { readonly status: "saved"; readonly receipt: Receipt; readonly newer: boolean } | { readonly status: "failed"; readonly reason: string; readonly newer: boolean };
+export type ConfirmResult = { readonly status: "confirmed"; readonly wrote: boolean; readonly receipt: Receipt } | { readonly status: "newer"; readonly receipt: Receipt } | { readonly status: "failed"; readonly reason: string };
+export type DiscardResult = { readonly status: "discarded"; readonly restored: Receipt } | { readonly status: "rejected" | "blocked"; readonly reason: string };
+export type ReplaceResult = { readonly status: "replaced"; readonly epoch: number } | { readonly status: "rejected"; readonly reason: string };
+export interface ReplaceRequest {
+  readonly intent?: "replace";
+  readonly expectedEpoch?: number;
+}
+
+/** 코어 가변 상태 — io 청크가 같은 객체를 읽고 쓴다 */
+export interface CoreState {
+  doc: PageDoc;
+  mark: number;
+  savedMark: number;
+  inflight: number;
+  epoch: number;
+  confirmed: Receipt | undefined;
+  attached: RenderImages;
+  committed: RenderImages;
+  discarding: boolean;
+  chain: Promise<unknown>;
+}
+
+/** 포트(1.3) — 제품 LocalSync가 구현 */
+export interface CorePort {
+  mode(): Promise<string>;
+  head(projectId: string): Promise<{ readonly revision: number; readonly hash: string } | undefined>;
+  commit(projectId: string, doc: PageDoc, bound: RenderImages): Promise<void>;
+  verify(projectId: string, receipt: Receipt): Promise<boolean>;
+  /** discard 복귀 문서(마지막 커밋 레코드의 문서) */
+  stored(projectId: string): Promise<PageDoc | undefined>;
+}
+
+/** 조작 뒤 io 본문 */
+export interface CoreIo {
+  save(s: CoreState, link: CoreLink, projectId: string): Promise<SaveResult>;
+  confirm(s: CoreState, link: CoreLink, projectId: string, save: () => Promise<SaveResult>): Promise<ConfirmResult>;
+  discard(s: CoreState, link: CoreLink, projectId: string): Promise<DiscardResult>;
+  replace(s: CoreState, next: PageDoc, request: ReplaceRequest, blobs?: RenderImages): ReplaceResult;
+}
+
+/** io + 포트(local만) + 메모리 커밋(DocBook) */
+export interface CoreLink {
+  readonly io: CoreIo;
+  readonly port: CorePort | undefined;
+  /** DocBook 메모리 커밋(saved 뒤 맞춤 · memory 모드 저장) */
+  readonly book: (doc: PageDoc, revision: number) => unknown;
+}
+
+export function createSaveCore(projectId: string, seed: PageDoc, connect: () => Promise<CoreLink>, starter?: () => Promise<void>) {
+  const s: CoreState = { doc: seed, mark: 0, savedMark: 0, inflight: 0, epoch: 0, confirmed: { hash: seed.hash, revision: seed.revision, mark: 0, proof: "hydrated" }, attached: {}, committed: {}, discarding: false, chain: Promise.resolve() };
+  let leases = 0;
+  let live: { readonly mountId: string; readonly token: number } | undefined;
+  const save = (): Promise<SaveResult> => {
+    if (s.discarding) return Promise.resolve({ status: "failed", reason: "discarding", newer: false });
+    s.inflight += 1;
+    const run = s.chain.then(connect).then((link) => link.io.save(s, link, projectId)).finally(() => (s.inflight -= 1));
+    s.chain = run.catch(() => undefined);
+    return run;
+  };
+  return {
+    edit(next: PageDoc, blobs?: RenderImages) {
+      s.doc = next;
+      s.mark += 1;
+      if (blobs) s.attached = { ...s.attached, ...blobs };
+      return s.mark;
+    },
+    save,
+    confirm: () => connect().then((link) => link.io.confirm(s, link, projectId, save)),
+    discard: () => connect().then((link) => link.io.discard(s, link, projectId)),
+    replace: (next: PageDoc, request: ReplaceRequest, blobs?: RenderImages) => connect().then((link) => link.io.replace(s, next, request, blobs)),
+    /** 같은 mountId 재요청(StrictMode) = 같은 토큰 · release 뒤 = 새 토큰 */
+    acquire(mountId: string) {
+      if (live?.mountId === mountId) return live.token;
+      leases += 1;
+      live = { mountId, token: leases };
+      return leases;
+    },
+    release(token: number) {
+      if (live?.token === token) live = undefined;
+    },
+    retryStart: async () => starter?.(),
+    view() {
+      const { doc, mark, savedMark, inflight, epoch, confirmed, attached } = s;
+      return { doc, mark, dirty: mark > savedMark, inflight: inflight > 0, epoch, confirmed, images: attached };
+    },
+  };
+}
+
+export type SaveCore = ReturnType<typeof createSaveCore>;
+
+/** 저장소 능력(선택) — ImageKeeper와 같은 모양(MQ-6-1) */
+export interface CoreKeeper {
+  readonly core?: (projectId: string, seed: PageDoc) => SaveCore;
+}
